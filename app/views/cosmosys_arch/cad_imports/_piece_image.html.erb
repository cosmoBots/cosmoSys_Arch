<% saved = @piece_views.find %>
<% if @piece_views.current?(saved) && saved.image.visible?(User.current) %>
  <%= link_to image_tag(arch_cad_piece_image_path(@issue), alt: @issue.subject, style: 'max-width:100%;max-height:550px'), arch_cad_view_path(@issue), class: 'architecture-piece-image' %>
<% else %>
  <div data-architecture-piece-bootstrap
       <% if local_assigns[:report] %>data-cosmosys-report-resource="pending" data-report-piece
       data-timeout-label="<%= l(:text_cosmosys_arch_report_capture_timeout) %>"
       data-unsaved-label="<%= l(:text_cosmosys_arch_report_capture_unsaved) %>" style="text-align:center"<% end %>>
    <p role="status"><%= l(:label_loading) %></p>
    <% if local_assigns[:report] %><p data-piece-fallback><%= link_to @issue.subject, arch_cad_view_path(@issue) %></p><% end %>
    <a data-piece-generated-image href="<%= arch_cad_view_path(@issue) %>" hidden><img alt="<%= @issue.subject %>" style="max-width:100%;max-height:<%= local_assigns[:report] ? CosmosysArch::CadItemsHelper::REPORT_PIECE_MAX_HEIGHT_PX : 550 %>px;object-fit:contain"></a>
    <% if local_assigns[:report] %><template data-piece-renderer-template><% end %>
    <div data-piece-renderer style="position:absolute;left:-10000px;width:800px;height:600px;overflow:hidden" aria-hidden="true" inert>
      <%= render partial: 'cosmosys_cad_preview/temporary_viewer' %>
    </div>
    <% if local_assigns[:report] %></template><% end %>
    <%= render partial: 'cosmosys_arch/cad_imports/piece_camera', locals: {automatic: true, report: local_assigns[:report]} %>
  </div>
<% end %>
