<% unless local_assigns[:poris_simulation] %>
  <p class="info"><%= l(:text_cosmosys_arch_pose_temporary) %></p>
<% end %>
<%= render partial: 'cosmosys_arch/cad_imports/piece_camera', locals: {readonly: local_assigns[:poris_simulation]} %>
<div class="cosmosys-arch-viewer <%= 'arch-cad-with-controls' unless local_assigns[:presentation_only] %>">
  <div id="arch-cad-controls" <%= 'hidden' if local_assigns[:presentation_only] %> data-ready-label="<%= l(:label_cosmosys_arch_controls_ready) %>">
    <h3><%= l(:label_cosmosys_arch_dofs) %></h3>
    <% @dofs.each do |item| %>
      <div class="arch-cad-control-row">
        <div><%= link_to item.subject, issue_path(item) %>
          <small>(<%= item.arch_axis %>, <%= item.arch_space %>, <%= item.arch_motion == 'rotation' ? '°' : 'm' %>)</small>
        </div>
        <input type="number" aria-label="<%= item.subject %>" data-arch-control="<%= item.csid %>" data-default="<%= item.arch_default %>" min="<%= item.arch_min %>" max="<%= item.arch_max %>" step="<%= item.arch_step %>" value="<%= item.arch_default %>" disabled>
        <input type="range" class="arch-cad-slider" data-arch-slider="<%= item.csid %>" aria-label="<%= item.subject %>" disabled>
      </div>
    <% end %>
    <button type="button" data-arch-reset disabled><%= l(:label_cosmosys_arch_reset_pose) %></button>
    <p role="status"><%= l(:label_loading) %></p>
    <h3><%= l(:label_cosmosys_arch_nodes) %></h3>
    <nav class="arch-cad-node-tree" aria-label="<%= l(:label_cosmosys_arch_nodes) %>">
      <%= render partial: 'cosmosys_arch/cad_imports/node_tree', locals: {nodes: @cad_navigation} %>
    </nav>
  </div>
  <div style="min-width:0"><%= render partial: 'cosmosys_cad_preview/temporary_viewer', locals: {presentation_only: local_assigns[:presentation_only]} %></div>
</div>
<script type="application/json" id="arch-cad-configuration"><%= raw(json_escape(JSON.generate(@configuration))) %></script>
<% content_for :header_tags do %>
  <script type="module">
    import {ModelControls} from <%= raw(asset_path('plugin_assets/cosmosys_cad_preview/model_controls.js').to_json) %>;
    import {initializeArchitectureControls} from <%= raw(asset_path('plugin_assets/cosmosys_arch/cad_architecture.js').to_json) %>;
    initializeArchitectureControls(ModelControls, document.getElementById(<%= raw((@architecture_inline_issue ? "architecture-cad-item-#{@architecture_inline_issue.id}" : '').to_json) %>) || document);
  </script>
  <style>.cosmosys-arch-viewer .cad-preview-canvas { height:65vh;min-height:400px } .cosmosys-arch-viewer .cad-preview-toolbar-group:has([data-cad-view]) { display:none }</style>
  <style>
    .arch-cad-with-controls { display:grid;grid-template-columns:minmax(0,14rem) minmax(0,1fr);gap:1em }
    #arch-cad-controls { min-width:0;overflow-wrap:anywhere }
    #arch-cad-controls [data-arch-reset] { max-width:100%;white-space:normal }
    .arch-cad-control-row { display:grid;grid-template-columns:minmax(0,1fr) 7em;align-items:center;gap:.5em;margin:.6em 0 }
    .arch-cad-control-row small { display:block;color:#666 }
    .arch-cad-control-row [data-arch-control] { width:100%;min-width:0;box-sizing:border-box;text-align:right }
    .arch-cad-control-row .arch-cad-slider { grid-column:1 / -1;width:100%;min-width:0;height:1.25em;margin:0;box-sizing:border-box }
    @media (max-width:760px) { .arch-cad-with-controls { grid-template-columns:minmax(0,1fr) } }
    .arch-cad-node-tree { max-height:45vh;overflow:auto }
    .arch-cad-node-tree ul { list-style:none;margin:0;padding-left:1.1em }
    .arch-cad-node-tree > ul { padding-left:0 }
    .arch-cad-node-tree summary { cursor:pointer }
    .arch-cad-node-tree li { margin:0.25em 0;overflow-wrap:anywhere }
    .arch-cad-node-leaf { display:block;padding-left:1.1em }
    .arch-cad-current-node { font-weight:bold;background:var(--cosmosys-selected-bg,#e6efff);border-radius:2px }
  </style>
<% end %>
